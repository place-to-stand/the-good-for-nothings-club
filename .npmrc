# Supply-chain cooldown: only install versions published 7+ days ago.
# React and Next (plus Vercel's other packages) are exempt so we can take their
# releases as soon as they ship. Lockstep companions are exempt too, or a
# same-week bump fails with ETARGET: react-dom pulls in a same-day scheduler,
# and next pulls in exact-version @next/env and @next/swc-* binaries.
min-release-age=7
min-release-age-exclude[]=react
min-release-age-exclude[]=react-dom
min-release-age-exclude[]=scheduler
min-release-age-exclude[]=next
min-release-age-exclude[]=eslint-config-next
min-release-age-exclude[]=@next/*
min-release-age-exclude[]=@vercel/*
min-release-age-exclude[]=botid
min-release-age-exclude[]=styled-jsx
